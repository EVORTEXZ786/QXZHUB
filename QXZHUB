<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QXZ Scripts - MM2 Visual Larp</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #000000;
            color: #ffffff;
        }

        /* Staggered load animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes bounceSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(10px); }
        }

        .animate-fade-1 { animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-fade-2 { opacity: 0; animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards; }
        .animate-fade-3 { opacity: 0; animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards; }
        .animate-fade-4 { opacity: 0; animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards; }

        .animate-bounce-slow {
            animation: bounceSlow 2s ease-in-out infinite;
        }

        /* Pure Black & White Glassmorphism */
        .glass-panel {
            background: rgba(10, 10, 10, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .glass-nav {
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative overflow-x-hidden selection:bg-white selection:text-black">

    <!-- TOP NAVIGATION BAR (Categories) -->
    <header class="fixed top-0 left-0 w-full z-40 glass-nav transition-all duration-300 animate-fade-1">
        <div class="max-w-6xl mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#homepage" class="flex items-center gap-3 group">
                <div class="w-9 h-9 rounded-xl bg-white text-black font-black text-sm flex items-center justify-center tracking-tighter shadow-lg group-hover:scale-105 transition-transform">
                    QXZ
                </div>
                <span class="font-extrabold text-xl text-white tracking-tight">QXZ Scripts</span>
            </a>

            <!-- Categories Links -->
            <nav class="hidden md:flex items-center gap-2 p-1.5 rounded-full bg-white/5 border border-white/10 text-sm font-bold text-neutral-300">
                <a href="#homepage" class="px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all">Homepage</a>
                <button onclick="openKeyModal()" class="px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all cursor-pointer">Get a Key</button>
                <a href="#scripts" class="px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all">Scripts</a>
                <a href="#tos" class="px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all">Terms of Service</a>
            </nav>

            <!-- Get Key Action Button -->
            <div class="flex items-center gap-3">
                <button onclick="openKeyModal()" class="bg-white hover:bg-neutral-200 text-black font-bold text-xs py-2.5 px-5 rounded-full transition-all shadow-lg active:scale-95 cursor-pointer">
                    Get Key
                </button>
                <button onclick="toggleMobileMenu()" class="md:hidden text-neutral-300 hover:text-white p-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                </button>
            </div>
        </div>

        <!-- Mobile Categories Dropdown -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-black/95 px-6 py-4 flex flex-col gap-3 text-sm font-bold text-neutral-300">
            <a href="#homepage" onclick="toggleMobileMenu()" class="py-2 hover:text-white">Homepage</a>
            <button onclick="openKeyModal(); toggleMobileMenu();" class="py-2 hover:text-white text-left cursor-pointer">Get a Key</button>
            <a href="#scripts" onclick="toggleMobileMenu()" class="py-2 hover:text-white">Scripts</a>
            <a href="#tos" onclick="toggleMobileMenu()" class="py-2 hover:text-white">Terms of Service</a>
        </div>
    </header>

    <!-- KEY SYSTEM & DISCORD AUTH MODAL -->
    <div id="authModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 backdrop-blur-md px-4">
        <div class="glass-panel w-full max-w-md rounded-2xl p-8 shadow-2xl border border-white/20 text-center animate-fade-1 relative">
            <button onclick="closeKeyModal()" class="absolute top-4 right-4 text-neutral-400 hover:text-white p-1 cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <span class="inline-block px-3.5 py-1 mb-3 text-xs font-bold tracking-widest uppercase bg-white text-black rounded-full shadow-md">
                Key System
            </span>
            <h2 class="text-2xl font-extrabold text-white mb-2">QXZ Verification</h2>
            <p id="modalInstruction" class="text-sm text-neutral-400 mb-6">Log in with Discord to tie your 24-hour key to your account.</p>

            <!-- Discord Login Section -->
            <div id="discordLoginSection">
                <button onclick="loginWithDiscord()" class="w-full bg-white hover:bg-neutral-200 text-black font-bold py-3.5 px-6 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 shadow-lg active:scale-95 cursor-pointer">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                    Login with Discord
                </button>
            </div>

            <!-- Key Checkpoints Section -->
            <div id="keySection" class="hidden space-y-4">
                <div class="flex items-center justify-center gap-3 p-3 bg-white/5 rounded-xl border border-white/10 text-xs">
                    <img id="userAvatar" src="https://cdn.discordapp.com/embed/avatars/0.png" class="w-7 h-7 rounded-full border border-white/20">
                    <span id="discordUsername" class="font-bold text-white">QXZ_User#1337</span>
                </div>
                
                <p class="text-xs text-neutral-400">Complete checkpoint to unlock access for 24 hours:</p>
                <div class="grid grid-cols-2 gap-2">
                    <a id="lootlabsBtn" href="https://lootlabs.com" target="_blank" class="bg-neutral-900 hover:bg-neutral-800 text-white font-semibold py-2.5 px-3 rounded-xl border border-white/15 text-xs transition-all flex items-center justify-center">
                        Get Key (LootLabs)
                    </a>
                    <a id="linkvertiseBtn" href="https://linkvertise.com" target="_blank" class="bg-neutral-900 hover:bg-neutral-800 text-white font-semibold py-2.5 px-3 rounded-xl border border-white/15 text-xs transition-all flex items-center justify-center">
                        Get Key (Linkvertise)
                    </a>
                </div>

                <div class="space-y-2 pt-2">
                    <input type="text" id="keyInput" placeholder="Paste generated key here..." class="w-full bg-black/70 border border-white/20 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-white transition-colors text-center">
                    <button onclick="verifyKey()" class="w-full bg-white hover:bg-neutral-200 text-black font-bold py-3 px-6 rounded-xl transition-all duration-200 shadow-lg cursor-pointer">
                        Verify Key & Unlock Access
                    </button>
                    <p id="keyError" class="text-xs text-red-400 hidden">Invalid key! Please complete the checkpoint link.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Background Emblem Image Layer -->
    <div class="fixed inset-0 z-0 pointer-events-none flex items-center justify-center">
        <div class="absolute inset-0 bg-cover bg-center filter grayscale contrast-125" style="background-image: url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2000&auto=format&fit=crop'); opacity: 0.12;"></div>
    </div>

    <!-- HOMEPAGE / HERO SECTION -->
    <section id="homepage" class="relative z-10 min-h-screen flex flex-col items-center justify-center text-center px-4 w-full max-w-4xl mx-auto pt-20">
        <div class="animate-fade-2">
            <span class="inline-block px-4 py-1.5 mb-4 text-xs font-bold tracking-widest uppercase bg-white/10 text-white rounded-full border border-white/20 shadow-lg">
                The Next Big Thing
            </span>
            <h1 class="text-5xl md:text-8xl font-extrabold tracking-tight text-white mb-4 drop-shadow-md">
                QXZ Scripts
            </h1>
            <p class="text-lg md:text-2xl text-neutral-300 font-medium max-w-xl mx-auto mb-8">
                Get your scripts below
            </p>

            <a href="#scripts" class="inline-block text-white/80 animate-bounce-slow p-2 cursor-pointer hover:text-white transition-colors" aria-label="Scroll down to scripts">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </a>
        </div>
    </section>

    <!-- SCRIPTS SECTION -->
    <section id="scripts" class="relative z-10 w-full max-w-4xl mx-auto px-4 py-24 animate-fade-3">
        <div class="w-full">
            <div class="glass-panel rounded-3xl p-6 md:p-10 shadow-2xl transition-all duration-300 hover:border-white/40">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-6 border-b border-white/10">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <span class="px-3 py-1 text-xs font-bold bg-white text-black rounded-md uppercase tracking-wider">MM2</span>
                            <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Working & Undetected
                            </span>
                        </div>
                        <h2 class="text-3xl font-bold text-white tracking-wide">MM2 Visual Weapon Larp Script</h2>
                    </div>
                </div>

                <p class="text-neutral-300 text-sm md:text-base mb-8 leading-relaxed">
                    Instantly load visual weapon larps and custom skins with clean UI layout and zero hassle. Use the loadstring below to execute in your preferred executor.
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <button onclick="copyLoadstring(this)" class="flex-1 bg-white hover:bg-neutral-200 text-black font-bold py-4 px-6 rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 shadow-xl active:scale-95 cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        Copy Loadstring
                    </button>
                    <button onclick="togglePreview()" class="bg-neutral-900 hover:bg-neutral-800 text-white font-semibold py-4 px-6 rounded-2xl border border-white/20 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                        Preview Code
                    </button>
                </div>

                <div id="codePreview" class="hidden mt-6 bg-black/90 border border-white/20 rounded-2xl p-4 overflow-x-auto font-mono text-xs text-neutral-300">
                    <code>loadstring(game:HttpGet("https://raw.githubusercontent.com/EVORTEXZ786/MM2QXZVISUALLARP/refs/heads/main/MM2QXZVISUALLARP"))()</code>
                </div>
            </div>
        </div>
    </section>

    <!-- TERMS OF SERVICE FOOTER -->
    <footer id="tos" class="relative z-10 w-full bg-black border-t border-white/10 py-12 px-6 mt-auto animate-fade-4">
        <div class="max-w-4xl mx-auto">
            <h3 class="text-lg font-bold text-white mb-4 uppercase tracking-wider">Terms of Service</h3>
            <p class="text-xs text-neutral-400 leading-relaxed mb-8">
                By accessing and utilizing QXZ Scripts, you agree to comply with our Terms of Service. All scripts, code snippets, and tools provided on this website are intended strictly for educational, research, and authorized development purposes. You are solely responsible for ensuring compliance with third-party service terms and software environments.
            </p>
            <div class="flex flex-col md:flex-row justify-between items-center pt-6 border-t border-white/10 gap-4 text-xs text-neutral-500 font-semibold">
                <p>QXZ Scripts &copy; 2026. All rights reserved.</p>
                <div class="flex gap-6">
                    <a href="#homepage" class="hover:text-white transition-colors">Homepage</a>
                    <a href="#scripts" class="hover:text-white transition-colors">Scripts</a>
                    <button onclick="openKeyModal()" class="hover:text-white transition-colors cursor-pointer">Get a Key</button>
                </div>
            </div>
        </div>
    </footer>

    <!-- Interactive JavaScript -->
    <script>
        const scriptText = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/EVORTEXZ786/MM2QXZVISUALLARP/refs/heads/main/MM2QXZVISUALLARP"))()';

        function toggleMobileMenu() {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        }

        function openKeyModal() {
            document.getElementById('authModal').classList.remove('hidden');
        }

        function closeKeyModal() {
            document.getElementById('authModal').classList.add('hidden');
        }

        function loginWithDiscord() {
            document.getElementById('discordLoginSection').classList.add('hidden');
            document.getElementById('keySection').classList.remove('hidden');
            document.getElementById('modalInstruction').innerText = "Step 2: Complete a checkpoint link to get your key.";
        }

        function verifyKey() {
            const keyInput = document.getElementById('keyInput').value.trim();
            const errorText = document.getElementById('keyError');

            if (keyInput.length > 0) {
                closeKeyModal();
            } else {
                errorText.classList.remove('hidden');
            }
        }

        function copyLoadstring(button) {
            navigator.clipboard.writeText(scriptText).then(() => {
                const originalHTML = button.innerHTML;
                button.innerHTML = `<svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Copied!`;
                button.classList.add('bg-emerald-400', 'text-black');
                button.classList.remove('bg-white', 'text-black');
                setTimeout(() => {
                    button.innerHTML = originalHTML;
                    button.classList.remove('bg-emerald-400', 'text-black');
                    button.classList.add('bg-white', 'text-black');
                }, 2000);
            });
        }

        function togglePreview() {
            document.getElementById('codePreview').classList.toggle('hidden');
        }
    </script>
</body>
</html>
